{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["playwright/**/*.ts", "scripts/**/*.ts", "database/**/*.ts", "electron/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
}
